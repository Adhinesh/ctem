# ==============================================================================
# CTEM Platform - Environment Configuration Template
# Copy this file to .env and fill in your Supabase credentials:
#   cp .env.example .env
# ==============================================================================

# Supabase Project Connection (REQUIRED)
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# National Vulnerability Database API Key (OPTIONAL)
# Requested from: https://nvd.nist.gov/developers/request-an-api-key
# Increases rate limits for CVE lookups during recon.
NVD_API_KEY=

# Blast Radius Engine Reachability Mode (OPTIONAL, default: same_subnet)
# Options: same_subnet | same_zone | dependency_edges | combined
BLAST_RADIUS_REACHABILITY_MODE=same_subnet

# Frontend API Base URL (OPTIONAL)
# Default is http://localhost:8000.
# If deploying to a remote server or VM, change to: http://<YOUR_SERVER_IP>:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
